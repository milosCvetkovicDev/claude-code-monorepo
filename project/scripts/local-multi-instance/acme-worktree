# ── Dispatch ─────────────────────────────────────────────────────────────────

# Every command except help needs paths/apps resolved from the config first.
case "${1:-help}" in
    help|--help|-h) ;;
    *) load_config ;;
esac

case "${1:-help}" in
    create) shift; cmd_create "$@" ;;
    remove|rm) shift; cmd_remove "$@" ;;
    list|ls) cmd_list ;;
    open) shift; cmd_open "$@" ;;
    configure|config) shift; cmd_configure "$@" ;;
    status) shift; cmd_status "$@" ;;
    align) shift; cmd_align "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    help|--help|-h) cmd_help ;;
    *) error "Unknown command: $1 (try 'acme-worktree help')" ;;
esac
